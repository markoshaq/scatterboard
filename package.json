{
  "name": "scatterboard",
  "version": "0.3.1",
  "description": "Local-first infinite-canvas planning board",
  "license": "MIT",
  "type": "module",
  "private": true,
  "author": "Marko Šekuljica",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markoshaq/scatterboard.git"
  },
  "homepage": "https://markoshaq.github.io/scatterboard/",
  "bugs": "https://github.com/markoshaq/scatterboard/issues",
  "keywords": [
    "moodboard",
    "infinite-canvas",
    "planning",
    "local-first",
    "offline",
    "pwa"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-size.mjs",
    "sizecheck": "node scripts/check-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "agent:setup": "node bridge/setup.mjs",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prebuild": "npm run typecheck && npm test",
    "lint": "biome lint src test vite.config.ts bridge/agent.mjs bridge/install.mjs bridge/setup.mjs",
    "version": "node scripts/sync-bridge-version.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@vitest/coverage-v8": "~5.1.1",
    "happy-dom": "^21.0.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19"
  }
}
